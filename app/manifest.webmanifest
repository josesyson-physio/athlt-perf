{
  "name": "Sportgram by MotionPlus",
  "short_name": "Sportgram",
  "description": "Find your weak side with free tests, train with your coach and physio, and learn from stories, slides and videos.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F4F4F6",
  "theme_color": "#F4F4F6",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's session",
      "short_name": "Session",
      "url": "./#/plans",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Mirror",
      "short_name": "Mirror",
      "url": "./#/mirror",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Run a test",
      "short_name": "Test",
      "url": "./#/tests",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Chat with my coach or physio",
      "short_name": "Chat",
      "url": "./#/chat",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
